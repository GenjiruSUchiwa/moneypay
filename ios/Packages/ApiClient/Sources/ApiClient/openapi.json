{
  "openapi": "3.1.1",
  "info": {
    "title": "MoniPay.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Reports that the host is answering.",
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/signups": {
      "post": {
        "tags": [
          "SignUps"
        ],
        "summary": "Starts a sign-up and queues its verification code.",
        "operationId": "StartSignUp",
        "requestBody": {
          "content": {
            "application/vnd.api+json": {
              "schema": {
                "$ref": "#/components/schemas/JsonApiRequestOfJsonApiRequestResourceOfStartSignUpAttributes"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonApiResponseOfSignUpResource"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "406": {
            "description": "Not Acceptable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/signups/{signUpId}": {
      "get": {
        "tags": [
          "SignUps"
        ],
        "summary": "Returns the state of a sign-up.",
        "operationId": "GetSignUp",
        "parameters": [
          {
            "name": "signUpId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonApiResponseOfSignUpResource"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "406": {
            "description": "Not Acceptable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Registration": [ ]
          },
          {
            "SignUp": [ ]
          }
        ]
      }
    },
    "/wallet": {
      "get": {
        "tags": [
          "Wallet"
        ],
        "summary": "Returns the balance, the holds, and what is available to spend.",
        "operationId": "GetWallet",
        "parameters": [
          {
            "name": "currency",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "required": [
          "status",
          "version"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "JsonApiLinks": {
        "type": "object",
        "properties": {
          "self": {
            "type": [
              "null",
              "string"
            ]
          },
          "related": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "JsonApiRelationship": {
        "type": "object",
        "properties": {
          "data": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonApiResourceIdentifier"
              }
            ]
          },
          "links": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonApiLinks"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "JsonApiRequestOfJsonApiRequestResourceOfStartSignUpAttributes": {
        "required": [
          "data"
        ],
        "type": "object",
        "properties": {
          "data": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonApiRequestResourceOfStartSignUpAttributes"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "JsonApiRequestResourceOfStartSignUpAttributes": {
        "required": [
          "type",
          "attributes"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "attributes": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/StartSignUpAttributes"
              }
            ]
          },
          "relationships": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonApiRelationship"
            }
          }
        },
        "additionalProperties": false
      },
      "JsonApiResourceIdentifier": {
        "required": [
          "type",
          "id"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "JsonApiResponseOfSignUpResource": {
        "required": [
          "data"
        ],
        "type": "object",
        "properties": {
          "jsonapi": {
            "$ref": "#/components/schemas/JsonApiVersion"
          },
          "data": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SignUpResource"
              }
            ]
          },
          "links": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonApiLinks"
              }
            ]
          }
        }
      },
      "JsonApiVersion": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SignUpAttributes": {
        "required": [
          "status",
          "signUpExpiresAt"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "codeDelivery": {
            "type": [
              "null",
              "string"
            ]
          },
          "signUpToken": {
            "type": [
              "null",
              "string"
            ]
          },
          "registrationToken": {
            "type": [
              "null",
              "string"
            ]
          },
          "codeExpiresAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "canResendAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "signUpExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SignUpResource": {
        "required": [
          "type",
          "id",
          "attributes"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "attributes": {
            "$ref": "#/components/schemas/SignUpAttributes"
          },
          "links": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonApiLinks"
              }
            ]
          }
        }
      },
      "StartSignUpAttributes": {
        "required": [
          "phone",
          "termsVersion",
          "privacyVersion"
        ],
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "termsVersion": {
            "type": "string"
          },
          "privacyVersion": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "WalletResponse": {
        "required": [
          "currency",
          "balance",
          "held",
          "available"
        ],
        "type": "object",
        "properties": {
          "currency": {
            "type": "string"
          },
          "balance": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "held": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "available": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      }
    },
    "securitySchemes": {
      "SignUp": {
        "type": "http",
        "description": "The sign-up workflow credential: Authorization: SignUp <token>.",
        "scheme": "SignUp"
      },
      "Registration": {
        "type": "http",
        "description": "The registration workflow credential: Authorization: Registration <token>.",
        "scheme": "Registration"
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "SignUps"
    },
    {
      "name": "Wallet"
    }
  ]
}