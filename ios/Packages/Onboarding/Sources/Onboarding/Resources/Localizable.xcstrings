    },
    "Use Face ID?": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer Face ID ?"
          }
        }
      }
    },
    "Verify": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier"
          }
        }
      }
    },
    "Visa or Mastercard, its own cap, frozen in one gesture. As many cards as you have needs.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa ou Mastercard, son propre plafond, gelée d'un geste. Autant de cartes que de besoins."
          }
        }
      }
    },
    "What is your\nnumber?": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel est votre\nnuméro ?"
          }
        }
      }
    },
    "Your biometric data never leaves your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données biométriques ne quittent pas votre iPhone."
          }
        }
      }
    },
    "Your details": {
      "extractionState": "manual",
      "localizations": {
