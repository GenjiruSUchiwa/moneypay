        }
      }
    },
    "Create a passcode": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un code secret"
          }
        }
      }
    },
    "Create my account": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer mon compte"
          }
        }
      }
    },
    "Email address": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse e-mail"
          }
        }
      }
    },
    "Enter the code": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez le code"
          }
        }
      }
    },
    "First name": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prénom"
          }
        }
      }
    },
    "It unlocks the app and confirms your sensitive payments.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il déverrouille l'application et valide vos paiements sensibles."
          }
        }
      }
    },
    "Last name": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom"
          }
        }
      }
    },
    "Later": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tard"
          }
        }
      }
    },
    "Licensed payment institution · CEMAC zone": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Établissement de paiement agréé · zone CEMAC"
          }
        }
      }
    },
    "MTN MoMo, Orange Money or an agent deposit. Your FCFA balance funds every dollar payment.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MTN MoMo, Orange Money ou dépôt agent. Votre solde FCFA finance chaque paiement en dollars."
          }
        }
      }
    },
    "Netflix, AWS, AliExpress. The rate and the margin are shown before every conversion.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, AWS, AliExpress. Le taux et la marge sont affichés avant chaque conversion."
          }
        }
      }
    },
    "One card per use,\ncreated in 30 seconds": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte par usage,\ncréée en 30 secondes"
          }
        }
      }
    },
    "Open the app and confirm payments without typing your passcode.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l'application et confirmez vos paiements sans saisir votre code."
          }
        }
      }
    },
    "Resend the code": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoyer le code"
          }
        }
      }
    },
    "Resend the code in %lld s": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoyer le code dans %lld s"
          }
        }
      }
    },
    "Send me the code": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevoir le code"
          }
        }
