{
  "sourceLanguage": "en",
  "strings": {
    "A six-digit code goes out to this line. It is also the line your Mobile Money top-ups arrive on.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un code à six chiffres part sur cette ligne. C'est aussi elle qui recevra vos rechargements Mobile Money."
          }
        }
      }
    },
    "Accepted wherever\nVisa and Mastercard are": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceptée là où\nVisa et Mastercard le sont"
          }
        }
      }
    },
    "By continuing you accept MoneyPay's terms and privacy policy.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En continuant, vous acceptez les conditions générales et la politique de confidentialité de MoneyPay."
          }
        }
      }
    },
    "Cards issued by our licensed partner bank.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartes émises par notre banque partenaire agréée."
          }
        }
      }
    },
    "Confirm your passcode": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez votre code"
          }
        }
      }
    },
    "Continue": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer"
