    },
    "Sent to %@": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyé au %@"
          }
        }
      }
    },
    "Sign in": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter"
          }
        }
      }
    },
    "The name must match your ID exactly — it is the one your cards will carry.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom doit correspondre exactement à votre pièce d'identité : c'est celui qui sera porté par vos cartes."
          }
        }
      }
    },
    "The passcodes do not match": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes ne correspondent pas"
          }
        }
      }
    },
    "Topped up with\nMobile Money": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechargée en\nMobile Money"
          }
        }
      }
    },
    "Turn on Face ID": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer Face ID"
          }
        }
