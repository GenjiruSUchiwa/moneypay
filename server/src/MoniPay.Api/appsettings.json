{
  "ConnectionStrings": {
    "MoniPay": ""
  },
  "MoniPay": {
    "ApplyMigrationsOnStartup": false,
    "ForwardedHeaders": {
      "KnownProxies": []
    },
    "RateLimits": {
      "StartPerHour": 20,
      "ResendPerHour": 30,
      "VerifyPerHour": 60,
      "CompletePerHour": 20,
      "RefreshPerHour": 120
    },
    "Sessions": {
      "Issuer": "",
      "Audience": "",
      "SigningKeyBase64": "",
      "PreviousSigningKeyBase64": "",
      "VerificationCodeKeyBase64": "",
      "PersonalDataKeyBase64": "",
      "SupportedCountries": [
        { "CallingCode": "237", "LocalLength": 9 },
        { "CallingCode": "225", "LocalLength": 10 },
        { "CallingCode": "221", "LocalLength": 9 },
        { "CallingCode": "241", "LocalLength": 8 },
        { "CallingCode": "243", "LocalLength": 9 },
        { "CallingCode": "229", "LocalLength": 8 }
      ],
      "VerificationCodeLength": 6,
      "VerificationCodeLifetime": "00:05:00",
      "ResendCooldown": "00:01:00",
      "MaximumResends": 3,
      "MaximumVerificationAttempts": 5,
      "SignUpLifetime": "00:15:00",
      "StartWindow": "01:00:00",
      "MaximumStartsPerWindow": 5,
      "AccessTokenLifetime": "00:10:00",
      "RefreshTokenLifetime": "30.00:00:00",
      "ClockSkew": "00:00:30",
      "Legal": {
        "TermsVersion": "",
        "PrivacyVersion": ""
      },
      "Cleanup": {
        "Enabled": true,
        "Interval": "00:10:00",
        "BatchSize": 500
      }
    },
    "Users": {
      "PersonalDataKeyBase64": ""
    },
    "Notifications": {
      "DataKeyBase64": "",
      "Retention": "30.00:00:00",
      "ProviderTimeout": "00:00:10",
      "Worker": {
        "Enabled": true,
        "PollInterval": "00:00:05",
        "BatchSize": 50,
        "LeaseDuration": "00:01:00"
      },
      "Sms": {
        "BaseUrl": "https://eu1.platform.bird.com",
        "ApiKey": "",
        "SenderId": ""
      },
      "Email": {
        "BaseUrl": "https://eu1.platform.bird.com",
        "ApiKey": "",
        "FromAddress": ""
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
